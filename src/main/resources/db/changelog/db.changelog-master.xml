<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="1" author="yourname">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="users"/>
            </not>
        </preConditions>
        <createTable tableName="users">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="username" type="varchar(255)">
                <constraints unique="true" nullable="false"/>
            </column>
            <column name="password" type="varchar(255)"/>
            <column name="currency_type" type="varchar(255)"/>
        </createTable>
    </changeSet>

    <changeSet id="2" author="yourname">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="wallets"/>
            </not>
        </preConditions>
        <createTable tableName="wallets">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="balance" type="double"/>
            <column name="currency" type="varchar(255)"/>
        </createTable>
    </changeSet>

    <changeSet id="3" author="yourname">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="inter_wallet_transactions"/>
            </not>
        </preConditions>
        <createTable tableName="inter_wallet_transactions">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="sender_wallet_id" type="bigint"/>
            <column name="receiver_wallet_id" type="bigint"/>
            <column name="transaction_type" type="varchar(255)"/>
            <column name="amount" type="double"/>
            <column name="timestamp" type="timestamp"/>
        </createTable>
    </changeSet>

    <changeSet id="4" author="yourname">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="intra_wallet_transactions"/>
            </not>
        </preConditions>
        <createTable tableName="intra_wallet_transactions">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="wallet_id" type="bigint"/>
            <column name="type" type="varchar(255)"/>
            <column name="amount" type="double"/>
            <column name="timestamp" type="timestamp"/>
        </createTable>
    </changeSet>
</databaseChangeLog>
